        {"id": "lora", "title": "LoRA Fine-Tuning", "concepts": ["Frozen base weights", "Low-rank ΔW = BA"], "lesson": null, "exercise": null},
        {"id": "rag", "title": "Retrieval-Augmented Generation", "concepts": ["Chunking", "Cosine similarity", "Context injection"], "lesson": null, "exercise": null}

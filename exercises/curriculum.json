{
  "courses": [
    {
      "id": "classical-ml",
      "title": "Classical Machine Learning",
      "tagline": "Losses, gradients and the estimators everything else is built on.",
      "description": "Derive the core estimators by hand: optimize a loss with gradient descent, regularize it, and learn to tell when training is actually converging.",
      "level": "Beginner",
      "tier": "free",
      "modules": [
        {"id": "regression", "title": "Linear & Ridge Regression", "concepts": ["MSE", "Gradient descent", "L2 regularization"], "lesson": "gradient_descent_intuition", "exercise": "linear_regression_gd"},
        {"id": "classification", "title": "Logistic Regression & SVM", "concepts": ["Sigmoid", "Binary cross-entropy", "Max margin", "Kernels"], "lesson": null, "exercise": null},
        {"id": "trees", "title": "Decision Trees & Random Forests", "concepts": ["Entropy", "Gini impurity", "Bagging"], "lesson": null, "exercise": null},
        {"id": "clustering", "title": "K-Means & GMMs", "concepts": ["Distance matrices", "EM loop", "Centroid updates"], "lesson": null, "exercise": null},
        {"id": "pca", "title": "Principal Component Analysis", "concepts": ["Covariance", "Eigendecomposition", "SVD"], "lesson": null, "exercise": null}
      ]
    },
    {
      "id": "deep-learning",
      "title": "Deep Learning Foundations",
      "tagline": "From array manipulation to forward passes and hand-written backprop.",
      "description": "Build the pieces of a neural network yourself, from non-linearities and their local gradients to full backpropagation, convolutions and recurrent state.",
      "level": "Intermediate",
      "tier": "free",
      "modules": [
        {"id": "activations", "title": "Activation Functions", "concepts": ["ReLU", "GELU", "Stable softmax", "Local gradients"], "lesson": "activations_and_backprop", "exercise": "activation_functions"},
        {"id": "mlp", "title": "Multilayer Perceptron Backprop", "concepts": ["Forward pass", "Jacobians", "Chain rule"], "lesson": null, "exercise": null},
        {"id": "cnn", "title": "Convolutional Networks", "concepts": ["Multi-channel conv", "Stride & padding", "Max-pooling"], "lesson": null, "exercise": null},
        {"id": "rnn", "title": "RNNs & LSTMs", "concepts": ["Hidden state", "BPTT", "Gradient clipping"], "lesson": null, "exercise": null}
      ]
    },
    {
      "id": "genai-llms",
      "title": "Generative AI & LLMs",
      "tagline": "The internals of transformers, and how to adapt and ground them.",
